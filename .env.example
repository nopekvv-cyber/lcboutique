# === Obligatorii ===
# Tokenul botului de la @BotFather
TELEGRAM_BOT_TOKEN=
# Cheia API Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# ID-ul grupului privat sursă, ex. -1001234567890 (scrieți /id în grup și botul vi-l spune)
SOURCE_CHAT_ID=
# ID-ul canalului LC boutique, ex. -1009876543210 (sau @numele_canalului dacă e public)
TARGET_CHAT_ID=

# === Opționale ===
# Unde primiți confirmările/avertismentele (implicit: în grupul sursă, ca reply)
REPORT_CHAT_ID=
# Doar aceste conturi pot trimite produse (ID-uri separate prin virgulă). Gol = oricine din grup.
ALLOWED_USER_IDS=
# Confirmare „✅ Publicat ... (calculul prețului)" în grupul sursă
CONFIRM_IN_SOURCE=true

# Prețul: (grivne × UAH_TO_LEI sau dolari × USD_TO_LEI) + SHIPPING_LEI + profit, rotunjit la terminațiile PRICE_ENDINGS
UAH_TO_LEI=0.50
# Prețurile producătorilor în dolari: dolari × USD_TO_LEI
USD_TO_LEI=20
SHIPPING_LEI=100
PRICE_ENDINGS=50,80,90
# Ce preț al producătorului se folosește când sunt mai multe (drop, opt, unspecified, retail)
PRICE_PRIORITY=drop,opt,unspecified,retail

# Secunde de liniște în grup după care produsele adunate se publică grupate pe categorii (0 = imediat)
PUBLISH_DELAY_SECONDS=60
# Secunde în care pozele și textul trimise separat sunt unite în același produs
PAIR_WAIT_SECONDS=25
ALBUM_WAIT_SECONDS=3

# claude-haiku-4-5 = ieftin și rapid (implicit); claude-opus-5 = mai precis, mai scump
ANTHROPIC_MODEL=claude-haiku-4-5
LOG_LEVEL=INFO
